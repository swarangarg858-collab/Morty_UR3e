  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="base"/>
  <joint name="base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="tool0"/>
  <joint name="flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>
  <!--
      Finger joint parameters used by these joints:
      - Left joint:  ${name}_close_open_joint
      - Right joint: ${name}_finger_right_joint

      Parameters:
      - hinge_rpy: joint frame rotation at the hinge (radians) for BOTH finger joints.
      - hinge_axis_xyz: revolute joint axis (flip sign to flip open/close direction) for BOTH finger joints.
      - lower/upper: joint limits in radians for BOTH finger joints.
      - effort: max joint torque (controllers/simulation) for BOTH finger joints.
      - velocity: max joint speed in rad/s (controllers/simulation) for BOTH finger joints.
      - mimic_multiplier/mimic_offset: ONLY used by ${name}_finger_right_joint to follow ${name}_close_open_joint.
      - base_mass/finger_mass: inertial masses (mainly for physics/simulation).
    -->
  <link name="gripper_base">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/zusammen_greifer_3_c8.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_blue">
        <color rgba="0.4 0.7 1.0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/collision/gripper_base_hull.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="tool0_gripper_fixed" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin rpy="0 0 0" xyz="0 0 0.01"/>
  </joint>
  <!--
        Camera frames:
          - ${camera_mount_link}: mount/visual frame placed on the gripper (CAD-aligned)
          - ${camera_link}: RealSense base frame (prefixed by driver to e.g. `camera_camera_link`)

        Keep ${camera_link} as `camera_camera_link` so it matches the RealSense-published TF tree.
        Add the fixed offset ${camera_mount_link} -> ${camera_link} here (camera_mount_to_camera_*).
      -->
  <link name="camera_mount">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/realsense_d345.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/collision/camera_mount_hull.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="tool0_camera_mount_fixed" type="fixed">
    <parent link="tool0"/>
    <child link="camera_mount"/>
    <origin rpy="1.5708 -1.5708 0" xyz="0.0001 -0.09405 -0.01335"/>
  </joint>
  <link name="camera_camera_link"/>
  <joint name="camera_mount_to_camera_camera_link_fixed" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_camera_link"/>
    <origin rpy="0 0 0" xyz="0.0042 0.0175 0.0125"/>
  </joint>
  <link name="gripper_finger_left">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/finger_left_co9.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/collision/finger_left_hull.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_close_open_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_finger_left"/>
    <!-- ${name}_close_open_joint: hinge_rpy + hinge_axis_xyz define the joint frame and rotation axis -->
    <origin rpy="0 0 0" xyz="-0.018 0.0035 0.056"/>
    <axis xyz="0 -1 0"/>
    <!-- ${name}_close_open_joint limits: lower/upper (rad), effort (Nm), velocity (rad/s) -->
    <limit effort="5.0" lower="0.0" upper="0.5" velocity="5.0"/>
  </joint>
  <link name="gripper_finger_right">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0.08726 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/finger_right_co9.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0.08726 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ur3e_learning_description/meshes/collision/finger_right_hull.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_finger_right_joint" type="revolute">
    <parent link="gripper_base"/>
    <child link="gripper_finger_right"/>
    <!-- ${name}_finger_right_joint: hinge_rpy + hinge_axis_xyz define the joint frame and rotation axis -->
    <origin rpy="0 0 0" xyz="0.018 0.0035 0.056"/>
    <axis xyz="0 -1 0"/>
    <!-- ${name}_finger_right_joint limits: lower/upper (rad), effort (Nm), velocity (rad/s) -->
    <limit effort="5.0" lower="-0.5" upper="-0.0" velocity="5.0"/>
    <!-- ${name}_finger_right_joint mimic: follows ${name}_close_open_joint -->
    <mimic joint="gripper_close_open_joint" multiplier="-1" offset="0"/>
  </joint>
  <!-- Optional TCP frame on the gripper base -->
  <link name="gripper_tcp"/>
  <joint name="gripper_base_to_tcp" type="fixed">
    <parent link="gripper_base"/>
    <child link="gripper_tcp"/>
    <origin rpy="0 0 0" xyz="0 0 0.12"/>
  </joint>
  <!-- ros2_control hardware interface for fake/mock hardware -->
  <ros2_control name="FakeSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="fake_sensor_commands">false</param>
      <param name="state_following_offset">0.0</param>
    </hardware>
    <!-- UR3e arm joints -->
    <joint name="shoulder_pan_joint">
      <command_interface name="position">
        <param name="min">-6.2832</param>
        <param name="max">6.2832</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position">
        <param name="min">-6.2832</param>
        <param name="max">6.2832</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_1_joint">
      <command_interface name="position">
        <param name="min">-6.2832</param>
        <param name="max">6.2832</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_2_joint">
      <command_interface name="position">
        <param name="min">-6.2832</param>
        <param name="max">6.2832</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.5708</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_3_joint">
      <command_interface name="position">
        <param name="min">-6.2832</param>
        <param name="max">6.2832</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Gripper joint -->
    <joint name="gripper_close_open_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- 2. Orient the complete Morty scene in an upright lab frame.
       Morty's known_up_base is [-0.7071, 0.7071, 0], defined in
       grasp_pipeline/grasp_pipeline/selection/params.py.
       This rotation maps that direction to lab_world +Z.
       The lab origin stays at the robot base. -->
  <link name="lab_world"/>
  <joint name="lab_world_to_world" type="fixed">
    <parent link="lab_world"/>
    <child link="world"/>
    <origin rpy="1.5707963267948966 0.7853981633974483 0" xyz="0 0 0"/>
  </joint>
  <link name="wall_link">
    <visual>
      <geometry>
        <box size="2.0 2.0 0.10"/>
      </geometry>
      <material name="wall_material">
        <color rgba="1.0 1.0 0.0 0.45"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="2.0 2.0 0.10"/>
      </geometry>
    </collision>
  </link>
  <joint name="world_to_wall" type="fixed">
    <parent link="world"/>
    <child link="wall_link"/>
    <origin rpy="0 0 0" xyz="0 0 -0.08"/>
  </joint>
</robot>


