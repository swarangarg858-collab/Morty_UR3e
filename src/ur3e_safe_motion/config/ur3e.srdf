<?xml version="1.0"?>
<robot name="ur3e_learning_workcell">
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- Ignore only touching/overlapping links that are mechanically adjacent. -->
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="flange" reason="Adjacent"/>
  <disable_collisions link1="flange" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_finger_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_finger_right" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="gripper_finger_left" link2="gripper_finger_right" reason="Never"/>
  <disable_collisions link1="tool0" link2="camera_mount" reason="Adjacent"/>
  <disable_collisions link1="camera_mount" link2="camera_camera_link" reason="Adjacent"/>
  <disable_collisions link1="camera_mount" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="wrist_3_link" reason="Never"/>

  <!-- Intentional touching at the stand/collar seam and around the post hole. -->
  <disable_collisions link1="controller_lower_base" link2="controller_top_collar" reason="Adjacent"/>
  <disable_collisions link1="controller_top_collar" link2="controller_center_rod" reason="Adjacent"/>
  <disable_collisions link1="controller_center_rod" link2="controller_top_box" reason="Adjacent"/>
  <disable_collisions link1="controller_center_rod" link2="controller_horizontal_cylinder" reason="Adjacent"/>
  <disable_collisions link1="controller_center_rod" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="controller_horizontal_cylinder" link2="controller_arm_mount" reason="Adjacent"/>
  <disable_collisions link1="controller_horizontal_cylinder" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="controller_horizontal_cylinder" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="controller_arm_mount" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="controller_arm_mount" link2="base_link_inertia" reason="Adjacent"/>
</robot>
